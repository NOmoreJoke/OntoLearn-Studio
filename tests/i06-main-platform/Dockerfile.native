# Own successfully frozen normal-main image; no other line's runtime/dependencies.
# Verified by prepare-build.mjs against the immutable local image ID.
FROM i06-main-platform:9fcba663-r11
USER root
RUN apt-get update && apt-get install -y --no-install-recommends xdotool scrot && rm -rf /var/lib/apt/lists/*
COPY --chown=i06:i06 harness/ /workspace/tests/i06-main-platform/
COPY --chown=i06:i06 identity.json /opt/i06-main-identity.json
USER i06
RUN npm exec -- eslint tests/i06-main-platform --max-warnings 0 \
    && node tests/i06-main-platform/runtime-manifest.mjs /workspace/.i06-main-build-manifest.json
ENTRYPOINT ["bash", "/workspace/tests/i06-main-platform/native-run.sh"]
