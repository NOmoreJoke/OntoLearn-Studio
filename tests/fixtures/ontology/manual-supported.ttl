@prefix ex: <urn:t02:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
ex:Equipment a rdfs:Class ; rdfs:label "设备"@zh, "Equipment"@en .
ex:Alarm a owl:Class .
ex:Pump a rdfs:Class ; rdfs:subClassOf ex:Equipment .
ex:hasAlarm a owl:ObjectProperty ; rdfs:domain ex:Equipment ; rdfs:range ex:Alarm .
ex:name a owl:DatatypeProperty ; rdfs:domain ex:Equipment ; rdfs:range xsd:string .
ex:001 a ex:Pump ; ex:name "泵站A" ; ex:hasAlarm ex:A01 .
ex:A01 a ex:Alarm .
