      "verify_native_extension": "def verify_native_extension(evidence: FrozenBuildEvidence) -> dict",
      "buildProgrammatic": "def prepare_build(repository_root: Path, output_dir: Path) -> dict; def finalize_build(repository_root: Path, output_dir: Path, engine_dir: Path) -> dict; def verify_external_binding(binding_path: Path, artifact_dir: Path, *, expected_sha256: str) -> dict (programmatic external-only; no CLI)"
    },
    "anchorHandling": "preflight never executes/imports anchor: find its standalone frozen spec/get_code, compile exact two-assignment template with actual bounded manifest/contract SHA values and declared flags0/dont_inherit/optimize0, compare filename-normalized code fingerprint; both anchor and manifest may be self-consistent while external root approval remains unknown",
    "opaqueEvidence": "FrozenBuildEvidence created only by successful load_frozen_provenance; exact class and module-private seal checked on use; keep canonical manifest+expectations as immutable bytes, resolved _MEIPASS and original interpreter identity; post-observer verification rechecks same frozen root/interpreter and actual loader code, no cached runtime success. No public constructor or caller paths/approval bits. This prevents incidental API misuse/mutation, not arbitrary malicious Python code with same-process introspection privilege.",
    "loadedModulesArgument": "exact dict with exactly the22 supplier module names as keys and their real current ModuleType objects; verify sys.modules object identity, module.__name__, spec.name, resolved __file__/spec.origin equal the artifact-relative expected path and actual get_code; private2 obtained from already-loaded sys.modules only, no importing target code; inspect already-loaded8-distribution Python modules against recorded files. Missing/unknown loader or runtime code mismatch rejects."
  },
  "buildApi": {
    "prepare_build": "(repository_root, output_dir) fixed private programmatic build helper, no CLI; output_dir fresh and under fixed build/i05-provenance; verify declared inputs equal Git HEAD bytes for selected files and no dirty tracked runtime inputs; parse22 supplier names/relative paths from literal AST without semantic import; read actual source/files/distributions using stdlib; record actual hashes and compile fingerprints; emit provenance+exact contract+anchor; never include anchor/PYZ/binding hashes inside provenance",
    "finalize_build": "(repository_root, output_dir, engine_dir) after PyInstaller; inspect actual PYZ without execution against source fingerprint rows, actual resource/metadata/license/data/native inventories; native hash domains separated; produce fresh full-directory binding outside artifact; no root-approved result",
    "inventoryArtifact": "programmatic only; complete regular files/directories/internal relative symlinks, reject outside symlinks/collisions/special files; chunked file hash with before/after stat stable checks; excludes no files inside artifact; binding outside artifact; fixed launcher present and executable"
  },
