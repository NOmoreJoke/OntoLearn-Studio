+    if supplied != expectations:
+        _fail("SCHEMA_INVALID")
+    raw = _read(_inside(root, STANDALONE_PROVENANCE), MANIFEST_CAP)
+    manifest = _json(raw, MANIFEST_CAP)
+    if _validate_manifest(manifest, contract) != supplied:
