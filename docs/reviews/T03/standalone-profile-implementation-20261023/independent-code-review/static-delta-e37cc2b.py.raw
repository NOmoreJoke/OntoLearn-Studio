s=contract['buildScratch'];assert s==load(P/'delta-f1-n1/build-scratch-map.json')==f['machineMap']
assert s['repositoryRelativeRunRoot']==layout['uniqueBuildRoot']=='build/i05-semantic-parity/<fresh-uuid>'
assert s['paths']=={'work':'pyinstaller','spec':'spec','dist':'dist','artifactDirectory':'dist/ontolearn-semantic-parity','uvCache':'evidence/cache/uv','pyinstallerCache':'evidence/cache/pyinstaller','tmp':'evidence/tmp','generated':'generated','generatedAnchor':'generated/_i05_semantic_parity_build_anchor.py','licenses':'licenses','provenance':lit(reader,'STANDALONE_PROVENANCE'),'contract':lit(reader,'STANDALONE_CONTRACT_BUNDLED'),'binding':'artifact-binding-v1.json','evidence':'evidence','buildRequest':'evidence/build-request-v1.json','provenanceRoot':'provenance'}
assert s['environment']=={'UV_CACHE_DIR':'uvCache','PYINSTALLER_CONFIG_DIR':'pyinstallerCache','TMPDIR':'tmp'}
assert s['argv']=={'--workpath':'work','--specpath':'spec','--distpath':'dist','--paths':'generated'}
assert type(s['sampling']['thresholdBytes']) is int and s['sampling']['thresholdBytes']==8589934592
assert s['sampling']['root']=='runRoot' and s['sampling']['recursive'] is True
assert all(s['sampling'][k] is False for k in ('builderEnforced','osHardLimitImplemented','runtimeGuarantee'))
assert s['executionGuard']['guardRequired'] is True and s['executionGuard']['permitDigestMayBypass'] is False and s['executionGuard']['missingOutcome']=='BUILD_SCRATCH_GUARD_REQUIRED'
unchanged=[]
for path in contract['sourceGuards']:
 if path not in {r['path'] for r in records}:
  a=git('rev-parse',C+':'+path);b=git('rev-parse',B+':'+path);assert a==b;unchanged.append(path)
assert len(unchanged)==32
