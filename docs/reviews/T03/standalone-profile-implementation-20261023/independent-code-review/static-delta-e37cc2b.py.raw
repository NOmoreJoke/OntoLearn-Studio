"""Independent fixed-delta AST/JSON/hash/Git audit; never evaluate/import product or unit."""
import ast
import hashlib
import json
import subprocess
from pathlib import Path
R=Path('/Users/kyle/Documents/工作/知爻/本体/.worktrees/T03-semantic-parity-profile-20261023')
P=R/'docs/reviews/T03/standalone-profile-implementation-20261023'
