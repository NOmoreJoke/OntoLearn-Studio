r={'format':'Independent-e37cc2b-delta-static/1','commit':C,'parent':B,'tree':commit[2],'products':records,'actualPatchExact':True,'patchLines':len(patch.splitlines()),'deltaManifest':{'bytes':len(manifest_raw),'sha256':sha(manifest_raw),'membersMatched':len(m['files'])},'readerOnlyContractConstantsChanged':True,'builderOnlyUnconditionalReceiptPathsAdded':True,'oldPythonUnitDefinitionsChanged':changed,'originalParentNodeLiteralUnchanged':True,'newPythonDefinitions':sorted(set(newfunc)-set(oldfunc)),'sourceGuard32Unchanged':unchanged,'firstReportAndEightMemberManifestUnchanged':True,'F1':'CLOSED_STATIC','N1':'CLOSED_STATIC','scratchMapping':'CONSISTENT_STATIC_ONLY; external required guard not executed','newBlockingP1P2':[],'unitGateRecommendation':'Eligible for controller exact single-file unit START; not started by reviewer','auditCompleted':True,'productUnitNodeStubBuildImportGUIExecuted':False}
