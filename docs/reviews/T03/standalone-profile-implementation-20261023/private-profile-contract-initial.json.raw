    "distributionFilesMetadataLicenses": {
      "rowPath": "installed-site-packages-relative path",
      "sourceRoot": "distribution.locate_file root inside own environment purelib/platlib; all resolved paths must stay under corresponding site root",
      "frozenRoot": "sys._MEIPASS",
      "rules": "Name/Version match exact8; metadata belongs corresponding dist-info; files paths unique per distribution; .py code path -> module (drop.py and final.__init__), native module exact declared extension basename stripping ABI suffix; data module/codeSha null"
    },
    "artifactBindingEntries": {
      "rowPath": "artifact-directory-relative path",
      "root": "the exact immutable engine directory passed by build helper or root external executor",
      "rules": "include every entry; no outside symlinks/special files; relative symlink target may contain.. only if full resolution remains inside root; root binding expectedSHA never supplied by package"
    }
  },
