  "identityRules": {
    "orderedUnique": "22 suppliers from final I05 list,4 public resources,2 fixed inputs,8 named distributions exactly once; no omissions/substitutions/duplicates; private modules exactly semantic_source_package_probe and semantic_build_provenance",
    "pathsAndTypes": "all arrays bounded, path->file role unique within each domain; explicit byte limits applied per role; native/data codeSha null and module null except native module name; python files require module+codeSha; file/directory/symlink binding fields use only corresponding nonnull fields",
    "finalPins": "current2cf/6891/401a declarations are not final approval; final new I05 repaired source must explicitly integrate before collecting final22/4/probe/entrypoint/reader/lock identities",
    "noRuntimeExecutionNow": "only static/unit/build helpers permitted; no new source/package CLI comparison or physical claims"
  },
  "requiredNegativeTests": [
    "duplicate/missing/extra/nonfinite/bool-int/depth/byte/count/path/escape/collision",
