      "packages/engine/src/ontolearn_engine/semantic_source_package_probe.py",
      "packages/engine/tests/test_semantic_source_package_probe.py"
    ]
  },
  "fixedLayout": {
    "profile": "i05-source-package-parity",
    "anchorModule": "_i05_semantic_parity_build_anchor",
    "anchorConstants": [
      "PROVENANCE_SHA256",
      "CONTRACT_SHA256",
      "PROFILE"
    ],
    "embeddedProvenance": "provenance/i05/source-package-parity-build.json",
    "embeddedContract": "provenance/i05/source-package-parity-private-contract-v1.json",
    "uniqueBuildRoot": "build/i05-semantic-parity/<fresh-uuid>",
    "generatedAnchor": "generated/_i05_semantic_parity_build_anchor.py",
    "artifactBinding": "artifact-binding-v1.json",
    "stagingCopy": null,
    "target": "packages/engine/src/ontolearn_engine/semantic_source_package_probe.py",
    "launcher": "ontolearn-semantic-parity",
    "evidence": "evidence/<prepare|pyinstaller|finalize>.<stdout|stderr>.log; builder reserves fresh run root with exact evidence/build-request-v1.json; prepare refuses other preexisting members"
  },
  "strictParsing": {
    "utf8": "strict; no BOM",
    "duplicateKeys": "reject at every object",
    "unknownOrMissingKeys": "reject at every typed object",
    "nonFiniteNumbers": "reject NaN Infinity -Infinity",
    "integer": "exact int, reject bool and floats",
    "strings": "exact str, reject NUL and lone surrogate; semantic paths NFC and relative POSIX",
    "jsonDepthMax": 16,
    "jsonNodesMax": 200000,
    "manifestBytesMax": 4194304,
    "contractBytesMax": 262144,
    "bindingBytesMax": 8388608,
    "sourceFileBytesMax": 2097152,
    "inputFileBytesMax": 8388608,
    "metadataBytesMax": 1048576,
    "licenseBytesMax": 1048576,
    "artifactFilesMax": 16384,
    "artifactSingleFileBytesMax": 134217728,
    "artifactTotalBytesMax": 536870912,
    "meaning": "private verifier read limits; no Q5/whole-H/RSS capacity or hard OS-timeout guarantee"
  },
  "fixedDistributions": {
    "pyparsing": "3.3.3",
    "pyshacl": "0.30.1",
    "rdflib": "7.6.0",
    "owlrl": "7.6.2",
    "packaging": "26.3",
    "prettytable": "3.18.0",
    "wcwidth": "0.9.2",
    "html5rdf": "1.2.1"
  },
  "fixedInputs": [
    {
      "path": "provenance/i05/source-package-parity/i05-source-package-parity-manifest.json",
      "bytes": 21202,
      "sha256": "0b91c1a9366d170b5614d94c20006054a5a959be235e0f46cb150cf32335193a"
    },
    {
      "path": "provenance/i05/source-package-parity/i05-source-package-parity-inputs.json",
      "bytes": 8205267,
      "sha256": "47c66ffe18613eb8cc1af6365dcfc9d866821f22c48f96d9f44725f8f7c59eaa"
    }
  ],
  "compileDomain": {
    "algorithm": "i05-code-object-marshal-filename-normalized/1",
    "source": "compile exact source bytes, flags=0,dont_inherit=True,optimize=0",
    "normalization": "recursively replace only CodeType.co_filename in code and nested co_consts with <i05-canonical-code>; preserve every other attribute, constants, flags and line/exception metadata",
    "serialization": "marshal.dumps(normalized_code,4), SHA256",
    "buildAndRuntime": "exact CPython sys.version/cache_tag/SOABI/MAGIC_NUMBER; sys.flags.optimize==0 required; no adapting hash to unexpected runtime optimization",
    "entrypoint": "exact source target bound independently to bounded CArchive s entry semantic_source_package_probe and canonical PYZ module; runtime alone cannot prove external target binding"
  },
  "runtimeApi": {
    "BuildProvenanceFault": "ValueError subclass; code fixed whitelist; no path/input details in public failure",
    "load_frozen_provenance": "keyword-only expectations object containing exact22 supplier source pins,4 public resources,2 fixed input pins,lock pin and fixed8 versions; returns opaque verified evidence; frozen-only; only bounded JSON/anchor/metadata/file checks before observer, no semantic/thirdparty/native imports",
    "verify_loaded_modules": "(evidence, modules) after I05 audit observer installed; no target imports inside verifier; inspect canonical sys.modules/module/spec/origin and actual loader.get_code for22 suppliers plus2 private modules and all currently-loaded thirdparty Python modules; compare actual normalized code, expected origins and source manifest; unknown loader rejects",
    "verify_native_extension": "(evidence) after observer and real runtime imports; never import extension itself; require exact wcwidth._wcwidth_c actual ExtensionFileLoader/sys.modules/origin under artifact; return actual file hash and loader facts. Absent/wrong-loader/outside-root fails. Installed-source native SHA vs ad-hoc-signed artifact SHA remain separate; source/native equivalence UNKNOWN unless separately proven by root. No pure-Python fallback success",
    "externalApproval": "all reader evidence explicitly rootApproval=unknown; packageCodeBoundToSource restricted to verified Python code/identified resources, never whole native artifact or semantic parity",
    "exactSignatures": {
      "load_frozen_provenance": "def load_frozen_provenance(*, expectations: dict, profile=\"parent-engine\") -> FrozenBuildEvidence",
      "verify_loaded_modules": "def verify_loaded_modules(evidence: FrozenBuildEvidence, modules: dict[str, ModuleType]) -> dict",
      "verify_native_extension": "def verify_native_extension(evidence: FrozenBuildEvidence) -> dict",
      "buildProgrammatic": "prepare_build(repository_root, output_dir, *, profile=\"parent-engine\"); finalize_build(repository_root, output_dir, engine_dir, *, profile=\"parent-engine\"); verify_external_binding(binding_path, artifact_dir, *, expected_sha256, profile=\"parent-engine\")"
    },
    "anchorHandling": "preflight never executes/imports anchor: find its standalone frozen spec/get_code, compile exact two-assignment template with actual bounded manifest/contract SHA values and declared flags0/dont_inherit/optimize0, compare filename-normalized code fingerprint; both anchor and manifest may be self-consistent while external root approval remains unknown",
    "opaqueEvidence": "FrozenBuildEvidence created only by successful load_frozen_provenance; exact class and module-private seal checked on use; keep canonical manifest+expectations as immutable bytes, resolved _MEIPASS and original interpreter identity; post-observer verification rechecks same frozen root/interpreter and actual loader code, no cached runtime success. No public constructor or caller paths/approval bits. This prevents incidental API misuse/mutation, not arbitrary malicious Python code with same-process introspection privilege.",
    "loadedModulesArgument": "exact dict with exactly the22 supplier module names as keys and their real current ModuleType objects; verify sys.modules object identity, module.__name__, spec.name, resolved __file__/spec.origin equal the artifact-relative expected path and actual get_code; private2 obtained from already-loaded sys.modules only, no importing target code; inspect already-loaded8-distribution Python modules against recorded files. Missing/unknown loader or runtime code mismatch rejects."
  },
  "buildApi": {
    "prepare_build": "exact35 clean Git source guards; separate source/frozen mapping; fresh root or exact builder-reserved evidence only; emit nested provenance/contract/anchor and actual license mirrors without executing semantic target",
    "finalize_build": "bounded actual CArchive and PYZ parsers, code/resource/license/native identities and complete directory binding; false rootApproved",
    "inventoryArtifact": "programmatic only; complete regular files/directories/internal relative symlinks, reject outside symlinks/collisions/special files; chunked file hash with before/after stat stable checks; excludes no files inside artifact; binding outside artifact; fixed launcher present and executable"
  },
  "externalExecutionContract": {
    "trustRoot": "root freezes expected binding SHA and complete actual engine-directory inventory before any new CLI comparison; a builder-produced binding rootApproved=false is a proposal only",
    "executor": "existing external execution owner reads expected SHA from root frozen record, checks binding bytes and actual entire target directory including symlinks/modes/launcher immediately before spawn; refuses missing/wrong/changed binding or artifacts; does not trust package self-description",
    "receiptFields": [
      "expectedBindingSha256",
      "actualBindingSha256",
      "artifactDirectory",
      "inventoryVerified",
      "exactArgv",
      "sourceCommit",
      "provenanceSha256",
      "startUtc",
      "endUtc",
      "exitCode",
      "stdoutIdentity",
      "stderrIdentity"
    ],
    "immutability": "after execution append receipt only; preserve original binding and actual unique artifact directory. Any change produces new immutable candidate/binding and new verification; never backfill approval",
    "join": "root joins external preflight/actual run receipt with reader actual-loader evidence by same artifact/provenance identity; reader success alone cannot grant root approval",
    "cli": "source [ownPython3.12,-m,ontolearn_engine.semantic_source_package_probe,--semantic-source-package-probe,selector]; frozen [actual-fixed-engine,--semantic-source-package-probe,selector]; exactly full-v1,b1-semantic-1x-v1,b1-semantic-10x-v1; no generic path/options",
    "entrypoint": "direct canonical probe script target; no parent entrypoint import; runtime canonical PYZ verification and external targetCode/full-directory approval remain distinct"
  },
