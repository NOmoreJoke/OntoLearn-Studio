"""External fee algebra. No product import, RDF parsing, matching, or typed issuer.

Input is a finite independent mathematical action tape, never observed product usage.
A tape is not evidence that its declared action inventory is complete.
"""

from dataclasses import dataclass
from hashlib import sha256
import json

VERSION = "i05-independent-fee-proposal/1"
POOLS = {
    "work": 16777216,
    "input_bytes": 262144,
    "output_bytes": 262144,
    "trace_items": 8192,
    "firings": 1024,
    "head_occurrences": 16384,
    "bindings": 1024,
}
LIMITS = {
    "term_bytes": 16384, "source_bytes": 65536, "digits": 4096,
    "integer_bits": 16384, "temporary_bits": 32768, "rules": 100,
    "when": 16, "comparisons": 32, "heads": 16, "variables": 64,
}


def natural(value):
    if type(value) is not int or value < 0:
        raise ValueError("nonnegative exact integer required")
    return value


def limb(value):
    if type(value) is not int:
        raise ValueError("exact integer required")
    return max(1, (abs(value).bit_length() + 31) // 32)


def allocation(rules, pools=None):
    """rules: exact list of (rule_id, disabled), ordinal is original list position."""
    pools = POOLS if pools is None else pools
    if type(rules) is not list or len(rules) > 100:
        raise ValueError("bounded rule list required")
    ids = []
    for entry in rules:
        if type(entry) is not tuple or len(entry) != 2:
            raise ValueError("rule tuple required")
        rule_id, disabled = entry
        if type(rule_id) is not str or not rule_id or len(rule_id.encode()) > 16384:
            raise ValueError("bounded nonempty rule ID required")
        if type(disabled) is not bool or rule_id in ids:
            raise ValueError("unique ID and exact disabled bool required")
        ids.append(rule_id)
    for total in pools.values():
        natural(total)
    ordered = sorted(enumerate(rules), key=lambda pair: pair[1][0])
    if not ordered:
        ordered = [(None, (None, False))]
    count = len(ordered)
    return [
        {
            "slot": slot, "rule_id": rule_id, "original_ordinal": ordinal,
            "disabled": disabled, "dummy": ordinal is None,
            "pools": {name: total // count + int(slot < total % count)
                      for name, total in pools.items()},
        }
        for slot, (ordinal, (rule_id, disabled)) in enumerate(ordered)
    ]


def revalidation_caps(children):
    """Authorized bound, not an exact invoice or an issuance receipt."""
    control = sum(203 + 33 * natural(c["firings"]) + 4 * natural(c["output_bytes"])
                  for c in children)
    return {"work": 3 * sum(natural(c["work"]) for c in children) + control,
            "input_bytes": 2 * sum(natural(c["input_bytes"]) for c in children),
            "output_bytes": 2 * sum(natural(c["output_bytes"]) for c in children),
            "control": control}


def restore_caps(b, q, j, n, f, m, u, s):
    """851e section6 upper bounds only. All symbols independently supplied."""
    for value in (b, q, j, n, f, m, u, s):
        natural(value)
    if not (b <= 8388608 and q <= 16777216 and j <= b + q and 1 <= n <= 100
            and f <= 1024 and m <= 131072 and u <= m and s <= b + 64 * m):
        raise ValueError("outside authorized symbolic bounds")
    return {
        "wire": 6 * (b + q), "schema": 4096 * (b + q + j),
        "traversal": 512 * j + 64 * m + 65536 * n,
        "integer_hex": 2048 * (b + q),
        "scan_copy": 64 * (b + q + s) + 65536 * (m + n),
        "cache_query": 257 * (s + m), "cache_split": 512 * u,
        "cache_alloc": 320 * (2 * u + n) + 64 * u + 16 * m,
        "rule_lookup": (f + 2 * n + 1) * (101 * b + n) + 65536 * n,
        "pv_compare": 1048576 * m,
        "hash": 32 * b + 8 * q + s + 32 * m + 65536 * n,
        "scalar": 16 * (b + q + s + 65536 * m + 65536 * n) + 4096,
        "objects": 8 * j + 16 * m + 2048 * n + 4096 + 257 * (2 * u + n),
    }


def classify_interval(lower, upper, cap, complete=False):
    """No universal RESOURCE_LIMIT allowance. Equality admits this domain only."""
    natural(lower)
    natural(cap)
    if upper is not None and (natural(upper) < lower):
        raise ValueError("inverted interval")
    if lower > cap:
        return "must-reject-this-domain"
    if upper is not None and upper <= cap:
        return "fits-this-domain" if complete else "bounded-domain-only"
    return "pending"


def fee(action, units=0, left=0, right=0):
    """Proposed exact primitive work; +1 pays event bookkeeping, no recursive log."""
    natural(units)
    natural(left)
    natural(right)
    if action in {"visit", "slot", "scan", "copy", "hash", "field", "release",
                  "receipt", "cleanup", "capture", "binding", "comparison", "head",
                  "definition", "proof", "trace", "candidate", "sort_compare"}:
        base = units
    elif action == "mul" or action == "divrem":
        base = max(1, left) * max(1, right)
    elif action in {"add", "sub", "shift", "limb_compare"}:
        base = max(1, left, right)
    elif action == "direct_candidate":
        base = 8 * units
    elif action == "direct_step":
        base = 32 * units
    elif action == "direct_key_byte":
        base = 16 * units
    else:
        raise ValueError("unknown fee primitive")
    return 1 + base


@dataclass(frozen=True)
class Event:
    occurrence: str
    stage: str
    ledger: str
    action: str
    debit: tuple = ()
    reserve: tuple = ()
    release: tuple = ()
    semantic_error: str | None = None


class Invoice:
    """One-shot prepayment ledger. A failed event changes no counters.

    Completed prefix fees remain; later actions and success publication are absent.
    Cleanup is covered by a dedicated reservation made before data acquisition.
    """

    def __init__(self, caps, live_caps):
        self.caps = self._mapping(caps)
        self.live_caps = self._mapping(live_caps)
        self.state = "new"
        self.used = {key: 0 for key in self.caps}
        self.live = {key: 0 for key in self.live_caps}
        self.peak = self.live.copy()
        self.rows = []
        self.seen = set()
        self.first_error = None

    @staticmethod
    def _mapping(values):
        result = {}
        for key, value in values.items():
            if type(key) is not str:
                raise ValueError("string domain required")
            result[key] = natural(value)
        return result

    def begin(self):
        if self.state != "new":
            raise ValueError("one-shot ledger")
        self.state = "running"

    def apply(self, event):
        if self.state != "running":
            raise ValueError("terminal ledger cannot reopen")
        if not isinstance(event, Event) or not event.occurrence or event.occurrence in self.seen:
            raise ValueError("unique occurrence required")
        self.seen.add(event.occurrence)
        vectors = []
        for name in ("debit", "reserve", "release"):
            pairs = getattr(event, name)
            mapping = dict(pairs)
            if len(mapping) != len(pairs):
                raise ValueError("duplicate vector dimension")
            for value in mapping.values():
                natural(value)
            vectors.append(mapping)
        debit, reserve, release = vectors
        for key in debit:
            if key not in self.caps:
                raise ValueError("undeclared cumulative domain")
        for key in reserve.keys() | release.keys():
            if key not in self.live_caps:
                raise ValueError("undeclared live domain")
        # Stable dimension order is UTF8 byte order, cumulative then reserve then release.
        checks = [("debit", key, self.used[key] + debit[key], self.caps[key])
                  for key in sorted(debit)]
        checks += [("reserve", key, self.live[key] + reserve[key], self.live_caps[key])
                   for key in sorted(reserve)]
        for kind, key, amount, cap in checks:
            if amount > cap:
                self.state = "failed"
                self.first_error = {"event": event.occurrence, "stage": event.stage,
                                    "kind": kind, "domain": key, "required": amount,
                                    "cap": cap, "reason": "RESOURCE_LIMIT"}
                return False
        for key, value in release.items():
            if value > self.live[key] + reserve.get(key, 0):
                raise ValueError("release of unowned tickets")
        for key, value in debit.items():
            self.used[key] += value
        for key, value in reserve.items():
            self.live[key] += value
            self.peak[key] = max(self.peak[key], self.live[key])
        for key, value in release.items():
            self.live[key] -= value
        self.rows.append({"occurrence": event.occurrence, "stage": event.stage,
                          "ledger": event.ledger, "action": event.action,
                          "debit": debit, "reserve": reserve, "release": release,
                          "used": self.used.copy(), "live": self.live.copy(),
                          "peak": self.peak.copy()})
        if event.semantic_error is not None:
            self.state = "failed"
            self.first_error = {"event": event.occurrence, "stage": event.stage,
                                "reason": event.semantic_error}
            return False
        return True

    def finish(self, complete_inventory):
        if self.state != "running":
            raise ValueError("failed ledger has no success prefix")
        if type(complete_inventory) is not bool or not complete_inventory:
            raise ValueError("complete independent inventory required")
        self.state = "completed"
        return self.report()

    def report(self):
        return {"version": VERSION, "state": self.state, "used": self.used.copy(),
                "live": self.live.copy(), "peak": self.peak.copy(),
                "first_error": self.first_error, "rows": self.rows.copy(),
                "formalAuthority": False, "productExecuted": False}


def run_tape(caps, live_caps, events, complete_inventory=True):
    ledger = Invoice(caps, live_caps)
    ledger.begin()
    for event in events:
        if not ledger.apply(event):
            return ledger.report()
    return ledger.finish(complete_inventory)


def mathematical_plan_preimage(value):
    """New illustrative byte domain; never claims to be the current planDigest.

    Arrays retain order; exact string/bool/null/int only. JSON integers are a model
    fixture encoding, not the approved product wire integerHex encoding.
    """
    def check(item):
        if item is None or type(item) in (str, bool, int):
            if type(item) is str:
                item.encode("utf-8", "strict")
            return
        if type(item) is list:
            for element in item:
                check(element)
            return
        if type(item) is dict and all(type(k) is str for k in item):
            for key, element in item.items():
                check(key)
                check(element)
            return
        raise ValueError("closed mathematical value required")
    check(value)
    return (VERSION + "\x00plan\x00").encode() + json.dumps(
        value, ensure_ascii=True, sort_keys=True, separators=(",", ":"),
        allow_nan=False).encode("ascii")


def mathematical_plan_digest(value):
    return sha256(mathematical_plan_preimage(value)).hexdigest()
