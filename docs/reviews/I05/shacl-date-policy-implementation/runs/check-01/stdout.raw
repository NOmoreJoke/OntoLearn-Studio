            meters[id(self)] = item
            record["work"].append(item)
    
        def charge(self, amount=1):
            item = meters[id(self)]
            record["stage"] = self.stage
            try:
                original_charge(self, amount)
            except SemanticError:
                item["failure"] = {
                    "stage": self.stage,
                    "requested": amount,
                    "remaining": self.remaining,
                    "used": self.used,
