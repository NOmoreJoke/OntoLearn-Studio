import datetime
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

label=sys.argv[1]; argv=sys.argv[2:]; output=Path(__file__).resolve().parent
base=Path(tempfile.mkdtemp(prefix="directsteps-module-"+label+"-"))
env=dict(os.environ);env["TMPDIR"]=str(base);env["PYTHONDONTWRITEBYTECODE"]="1"
r={"argv":argv,"cwd":os.getcwd(),"start":datetime.datetime.now(datetime.UTC).isoformat(),"timeoutSeconds":180,"basetemp":str(base),"env":{"TMPDIR":str(base),"PYTHONDONTWRITEBYTECODE":"1"}}
source=Path("packages/engine/src/ontolearn_engine/semantic_profile_directsteps.py")
r["sourceBeforeSha256"]=hashlib.sha256(source.read_bytes()).hexdigest()
try:
 p=subprocess.run(argv,env=env,capture_output=True,timeout=180);stdout,stderr,code=p.stdout,p.stderr,p.returncode;timeout=False
except subprocess.TimeoutExpired as e:
 stdout,stderr,code=e.stdout or b"",e.stderr or b"",None;timeout=True
r.update(end=datetime.datetime.now(datetime.UTC).isoformat(),exitCode=code,timeout=timeout,sourceAfterSha256=hashlib.sha256(source.read_bytes()).hexdigest())
for name,data in [("stdout",stdout),("stderr",stderr)]:
 path=output/(label+"."+name+".raw");path.write_bytes(data);r[name]={"path":path.name,"bytes":len(data),"sha256":hashlib.sha256(data).hexdigest()}
(output/(label+".json")).write_text(json.dumps(r,ensure_ascii=False,indent=2)+"\n")
print(json.dumps(r,ensure_ascii=False));print(stdout[-5000:].decode(errors="replace"));print(stderr[-5000:].decode(errors="replace"));sys.exit(1 if timeout else code)
