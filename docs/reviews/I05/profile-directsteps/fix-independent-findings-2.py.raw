from pathlib import Path
p=Path('packages/engine/src/ontolearn_engine/semantic_profile_restore.py');s=p.read_text().replace('''        _require(e.input_domain == "profile-structured-records-json/1", "entry")''','''        _require(type(e.input_domain) is str and e.input_domain == "profile-structured-records-json/1", "entry")''')
s=s.replace('''            _direct_stream(direct_ledger, size + preimage + 2048, passes=4)''','''            _direct_stream(direct_ledger, size + preimage + 2048, passes=4)
            from .semantic_profile_restore_budget import JSON_KEYS
            # Both lexical passes: each key scans <=n fixed strings and <=32
            # prior keys. Sum key lengths <=J, key count <=J/3, fixed length
            # <=maxlen. This deliberately loose expression covers both passes,
            # all fixed-key/prior-key byte comparisons and 256J other dispatch.
            # It is one D prepayment, not new R capacity or a refundable pool.
            factor = 256 + 4 * (len(JSON_KEYS) + 4) + sum(map(len, JSON_KEYS)) + 64 * max(map(len, JSON_KEYS))
            direct_ledger.debit("scan_copy", factor * (size + preimage))''')
s=s.replace('''    if decoder.explanation:
        _validate_explanation(decoder, native, original_records)''','''    if decoder.explanation:
        from .semantic_profile_production import _direct_json_size
        decoder.direct_ledger.note_carrier(_direct_json_size(raw["reasoning"]["directSteps"], decoder.direct_ledger))
        _validate_explanation(decoder, native, original_records)''')
pos=s.index('\ndef _validate_explanation(')
s=s[:pos]+'''
def _explanation_key(record, ledger):
    chars = sum(len(v) for term in record for v in
                (term.lexical_form, term.datatype_iri, term.language_raw) if v is not None)
    ledger.debit("work", 128 + 64 * chars)
    ledger.debit("scan_copy", 32 * chars + 128)
    ledger.reserve("scalar", 32 * chars + 128)
    ledger.reserve("objects", 64)
    return semantic._key(tuple(semantic._profile_term(term) for term in record))

''' +s[pos:]
a=s.index('            # Exact TermInput fields have passed');b=s.index('            identity = encode_identity_key',a)
s=s[:a]+'''            key = _explanation_key(record, ledger)
'''+s[b:]
a=s.index('        validate_direct_steps(')
s=s[:a]+'''        from hashlib import sha256
        from .semantic_profile_directsteps import DirectStepsFailure
        for leaf in native["proofLeaves"]:
            chars = sum(map(len, leaf["triple"])) + 32
            ledger.debit("work", 32 * chars + 128)
            ledger.debit("scan_copy", 32 * chars + 128)
            ledger.reserve("scalar", 32 * chars + 128)
            ledger.reserve("objects", 32)
            raw_leaf = ("i05-profile-proof-leaf/1\\0" + "\\0".join(leaf["triple"])).encode("utf-8")
            expected_id = "i05-proof:" + sha256(raw_leaf).hexdigest()
            if leaf["reference"] != expected_id:
                raise DirectStepsFailure(stage="restore")
        # Saved evidence must describe the actual decoded typed head occurrences,
        # not manufacture unrelated roots through range-valid indices.
        ledger.reserve("objects", 64 + 64 * len(native["evidence"]))
        actual_evidence = []
        for firing_index, firing in enumerate(native["firingGroups"]):
            inputs = [_explanation_key((t.subject,t.predicate,t.object), ledger) for t in firing.when]
            for head in firing.heads:
                actual_evidence.append({"rule": firing.rule_id, "firingIndex": firing_index,
                    "headIndex": head.index, "result": _explanation_key(
                        (head.triple.subject,head.triple.predicate,head.triple.object), ledger),
                    "inputs": inputs, "basis": firing.basis})
        _same(actual_evidence, native["evidence"], decoder.ledger, stage="A5")
        actual_evidence = inputs = firing = head = leaf = raw_leaf = expected_id = None
''' +s[a:]
s=s.replace('''    entries = key = identity = triple = record = None''','''    entries = key = identity = triple = record = actual_evidence = inputs = firing = head = leaf = raw_leaf = expected_id = None''')
s=s.replace('''        entries = key = identity = triple = record = native = original_records = None''','''        entries = key = identity = triple = record = actual_evidence = inputs = firing = head = leaf = raw_leaf = expected_id = native = original_records = None''')
