s=s.replace('''type(expected) is RestoreExpectation and type(allocation) is OriginalAllocation,''','''type(expected) is (RestoreExpectation if direct_ledger is None else ExplanationRestoreExpectation)
            and type(allocation) is OriginalAllocation,''')
s=s.replace('''        ledger.begin(size, preimage, len(allocation.children))''','''        if direct_ledger is not None:
            # Covers complete supplied J, all ordinary parse/project/hash/freeze
            # buffers. Original R opaque child reservations remain in R only.
            _direct_stream(direct_ledger, size + preimage + 2048, passes=4)
        ledger.begin(size, preimage, len(allocation.children))''')
s=s.replace('decoder = _Decoder(ledger, expected, allocation)', 'decoder = _Decoder(ledger, expected, allocation, direct_ledger)')
s=s.replace('''        outcome = (
            RestoredProfileResult(inner_batches, projection, rows_json, retention)
            if fullview
            else inner_batches
        )''','''        if direct_ledger is None:
            outcome = (RestoredProfileResult(inner_batches, projection, rows_json, retention)
