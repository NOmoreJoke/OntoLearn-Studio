s=s.replace('''    def reasoning(self, value):
        self.object(value, _REASONING)''','''    def direct_steps(self, value):
        self.object(value, ("format", "steps"))
        _require(value["format"] == "i05-direct-rdfs-steps/1")
        def premise(raw):
            self.object(raw, ("kind", "reference"))
            kind = self.string(raw["kind"], 4)
            _require(kind in ("leaf", "step"))
            reference = self.sha(raw["reference"][10:]) if False else None
            if kind == "leaf":
                reference = self.string(raw["reference"], 74)
            else:
                reference = self.integer(raw["reference"], minimum=0, maximum=99999)
            return {"kind": kind, "reference": reference}
        def step(raw):
            self.object(raw, ("ordinal", "rule", "result", "premises", "depth"))
            return {
                "ordinal": self.integer(raw["ordinal"], minimum=0, maximum=99999),
                "rule": self.string(raw["rule"], 64),
                "result": self.triple_key(raw["result"]),
                "premises": self.collect(raw["premises"], premise, maximum=2),
                "depth": self.integer(raw["depth"], minimum=1, maximum=100000),
            }
        return {"format": value["format"], "steps": self.collect(value["steps"], step, maximum=100000)}

    def reasoning(self, value):
        self.object(value, _REASONING + (("directSteps",) if self.explanation else ()))''')
s=s.replace('''            value["formatVersion"] == _FORMAT
            and value["semanticsVersion"] == _SEMANTICS''','''            value["formatVersion"] == ("i05-reasoning-result/3" if self.explanation else _FORMAT)
