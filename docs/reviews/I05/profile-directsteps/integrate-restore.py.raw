s=s.replace('''    except RestoreFailure as exc:
        error = RestoreFailure(''','''    except DirectStepsFailure as exc:
        error = DirectStepsFailure(exc.reason, stage=exc.stage, domain=exc.domain)
    except RestoreFailure as exc:
        error = RestoreFailure(''')
s=s.replace('''        children = parse_usage = caps = projection = inner_batches = retention = None''','''        children = parse_usage = caps = projection = inner_batches = retention = direct_receipt = None''')
s=s.replace('''        if error is not None:
            outcome = None
        try:''','''        if error is not None:
            outcome = None
            if direct_ledger is not None:
                direct_ledger.failed()
        try:''')
s += '''\n\ndef _validate_explanation(decoder, native, original_records):
    from .semantic_profile_directsteps import encode_identity_key, validate_direct_steps
    ledger = decoder.direct_ledger
    entries = key = identity = triple = record = None
    held = 8 * len(original_records) + 32
    ledger.reserve("objects", held)
    try:
        entries = []
        for record in original_records:
            # Exact TermInput fields have passed original typed decoder. The
            # formatter is prepaid before constructing any RDFLib term/N3.
            chars = sum(len(v) for term in record for v in
                        (term.lexical_form, term.datatype_iri, term.language_raw) if v is not None)
            ledger.debit("work", 128 + 64 * chars)
            ledger.debit("scan_copy", 32 * chars + 128)
            ledger.reserve("scalar", 32 * chars + 128)
            ledger.reserve("objects", 64)
            triple = tuple(semantic._profile_term(term) for term in record)
            key = semantic._key(triple)
            identity = encode_identity_key(record, ledger)
            entries.append((identity, key))
        validate_direct_steps(native["directSteps"], proof_leaves=native["proofLeaves"],
                              rdfs=native["rdfs"], rdfs_evidence=native["rdfsEvidence"],
                              seed_entries=tuple(entries), ledger=ledger)
    finally:
        entries = key = identity = triple = record = native = original_records = None
        ledger.discard(objects=held)


def restore_profile_explanation_result(payload_json, rows_json, *, expected, allocation,
                                       ledger, direct_ledger):
    """Explicit schema2 full result; local DAG checks never rerun inference."""
    from .semantic_profile_directsteps import DirectStepsLedger, DirectStepsFailure
    if type(direct_ledger) is not DirectStepsLedger:
        raise DirectStepsFailure()
    return _restore_operation(payload_json, rows_json, expected=expected, allocation=allocation,
                              ledger=ledger, fullview=True, direct_ledger=direct_ledger)


def explanation_roots(view, target_keys, *, direct_ledger):
    """All matching occurrences within an already granted complete fullview."""
    from .semantic_profile_directsteps import DirectStepsLedger, DirectStepsFailure, RootRef, locate_roots
    if type(direct_ledger) is not DirectStepsLedger:
        raise DirectStepsFailure()
    if direct_ledger.state != "new":
        raise DirectStepsFailure("DIRECT_STEPS_REUSED", stage=direct_ledger.stage)
    entries = result = reason = row = key = error = None
    held = 0
    try:
        direct_ledger.begin(stage="roots")
        if type(view) is not RestoredExplanationResult or type(target_keys) is not tuple:
            raise DirectStepsFailure(stage="roots")
        reason = view.projection.payload["reasoning"]
        leaves, steps, heads = reason["proofLeaves"].items, reason["directSteps"]["steps"].items, reason["evidence"].items
        count = len(leaves) + len(steps) + len(heads)
        direct_ledger.debit("work", 64 * count + 128)
        direct_ledger.reserve("objects", 16 * count + 128)
        held = 16 * count + 128
        entries = []
        for row in leaves:
            key = tuple(row["triple"].items)
            entries.append((key, RootRef("leaf", reference=row["reference"])))
        for row in steps:
            key = tuple(row["result"].items)
            entries.append((key, RootRef("step", ordinal=row["ordinal"])))
        for row in heads:
            key = tuple(row["result"].items)
            entries.append((key, RootRef("ruleHead", firing_index=row["firingIndex"], head_index=row["headIndex"])))
        result = locate_roots(tuple(entries), target_keys, direct_ledger)
        # RootRef objects in result remain covered by the retained block.
        entries = reason = row = key = leaves = steps = heads = None
        direct_ledger.receipt()
        direct_ledger.completed()
    except DirectStepsFailure as exc:
        error = DirectStepsFailure(exc.reason, stage=exc.stage, domain=exc.domain)
    except Exception:
        error = DirectStepsFailure("DIRECT_STEPS_INTERNAL", stage="roots")
    finally:
        entries = reason = row = key = view = target_keys = None
        if error is not None:
            result = None
            direct_ledger.failed()
    if error is not None:
        raise error
    return result
'''
s=s.replace('            reference = self.sha(raw["reference"][10:]) if False else None\n', '            reference = None\n')
p.write_text(s)
