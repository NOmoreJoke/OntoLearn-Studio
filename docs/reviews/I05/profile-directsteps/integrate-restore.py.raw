s=s.replace('def _freeze_projection(raw, native, ledger):', 'def _freeze_projection(raw, native, ledger, *, explanation=False):').replace('return RestoredProfileProjection(frozen)', 'return RestoredExplanationProjection(frozen) if explanation else RestoredProfileProjection(frozen)')
s=s.replace('raw = read_json(payload_json, ledger, label="payload")', 'raw = read_json(payload_json, ledger, label="payload", schema_version=expected.schema_version)')
s=s.replace('''    _require(raw["format"] == _FORMAT and raw["inputDigestDomain"] == expected.input_domain)''','''    _require(raw["format"] == ("i05-reasoning-result/3" if decoder.explanation else _FORMAT)
             and raw["inputDigestDomain"] == expected.input_domain)''')
s=s.replace('''    projection = _ProfileProjection()
    safe_reason = _project''','''    if decoder.explanation:
        _validate_explanation(decoder, native, original_records)
    projection = _ProfileProjection()
    safe_reason = _project''')
s=s.replace('_freeze_projection(raw, native, ledger) if fullview else None', '_freeze_projection(raw, native, ledger, explanation=decoder.explanation) if fullview else None')
s=s.replace('''    fullview: bool,
):''','''    fullview: bool,
    direct_ledger=None,
):''')
s=s.replace('''    if type(ledger) is not RestoreLedger:
        _invalid("entry")''','''    from .semantic_profile_directsteps import DirectStepsFailure, DirectStepsLedger
    from .semantic_profile_production import _direct_stream

    if direct_ledger is not None:
        if type(direct_ledger) is not DirectStepsLedger:
