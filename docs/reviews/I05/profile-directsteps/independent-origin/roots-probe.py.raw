"""Root refs must locate the retained actual firing/head occurrence."""
import copy,json
from pathlib import Path
from unittest.mock import patch
from ontolearn_engine import semantic
from ontolearn_engine import semantic_profile_directsteps as direct
from ontolearn_engine import semantic_profile_restore as restore
from ontolearn_engine.quality.rule_firing import RuleSpec,Triple,Variable
import test_semantic_profile_directsteps as support
out=Path('docs/reviews/I05/profile-directsteps/independent-origin')
def fees(d):return {'state':d.state,'used':d.used,'live':d.live,'peaks':d.peaks,'caps':d.caps,'events':d.events}
raw=support.records((('urn:p',support.TYPE,support.OWL+'ObjectProperty'),('urn:out',support.TYPE,support.OWL+'ObjectProperty'),('urn:x','urn:p','urn:y')))
when=Triple(Variable('?s'),support.iri('urn:p'),Variable('?o'));head=Triple(Variable('?s'),support.iri('urn:out'),Variable('?o'));rule=RuleSpec('fixture:r',(when,),(),(head,head))
computed,pd=support.produce(raw,(rule,));payload=copy.deepcopy(computed.wire['payload']);payload['reasoning']['evidence'][0]['firingIndex']={'integerHex':'0x3ff'};payload['reasoning']['evidence'][0]['headIndex']={'integerHex':'0xf'};wire,rebound=support.rebound(computed,payload);observations=[]
d=direct.DirectStepsLedger()
try:support.receive(computed,expected=support.expectation(computed),wire=wire,direct_ledger=d)
except Exception as exc:observations.append({'case':'forged-evidence-original-expected','rejected':True,'reason':getattr(exc,'reason',None),'fees':fees(d)})
else:raise AssertionError('unchanged expectation must reject')
d=direct.DirectStepsLedger()
with patch.object(semantic,'_profile_reason',side_effect=AssertionError('no reason during restore')):
 view,_=support.receive(computed,expected=rebound,wire=wire,direct_ledger=d)
rd=direct.DirectStepsLedger();refs=restore.explanation_roots(view,(support.key('urn:x','urn:out','urn:y'),),direct_ledger=rd)
observations.append({'case':'forged-evidence-rebound','restoreAccepted':True,'actualFiringGroups':len(computed.native_result['firingGroups']),'actualHeadIndices':[h.index for h in computed.native_result['firingGroups'][0].heads],'returnedRoots':refs,'allReturnedRootsExist':all(x.get('firingIndex',0)<len(computed.native_result['firingGroups']) and x.get('headIndex',0)<2 for x in refs),'restoreFees':fees(d),'rootsFees':fees(rd),'productionFees':fees(pd)})
# Private closure's contract disallows arbitrary capture callbacks.
callbacks=[]
class ArbitraryCapture:
 def candidate(self,rule):callbacks.append(rule);raise RuntimeError('foreign sink callback')
data=semantic.parse_turtle('<urn:x> <'+support.TYPE+'> <urn:A> . <urn:A> <'+support.SUB+'> <urn:B> .')
try:semantic._finite_closure(data,lambda *args:None,_direct_capture=ArbitraryCapture())
except Exception as exc:observations.append({'case':'private-closure-foreign-sink','callbacks':callbacks,'error':type(exc).__name__})
(out/'03-roots-observations.json').write_text(json.dumps(observations,indent=2)+'\n');print(json.dumps([{k:v for k,v in row.items() if not k.lower().endswith('fees')} for row in observations],sort_keys=True))
