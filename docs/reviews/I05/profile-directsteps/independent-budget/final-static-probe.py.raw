keys=JSON_KEYS+('directSteps','steps','premises','depth');n=len(keys);length=sum(map(len,keys));m=max(map(len,keys));factor=256+4*n+sum(map(len,JSON_KEYS))+64*max(map(len,JSON_KEYS));bound=(2*n+64)+(2*(length+n)+64*(m+1))/3
assert factor==3343 and factor>bound
print(json.dumps({'probe':'strict Reader schema proof constants','n':n,'sumKeyLength':length,'maxKeyLength':m,'logicalDoublePassSchemaCoefficientUpper':bound,'prepaidCoefficient':factor,'noRCapChanges':True}))
for label in ('01-live-and-reader','02-budget-tests','delta-ff90092-01-probe','delta-ff90092-02-budget-tests','delta-cb2662-03-added-regressions'):
 run=prefix/label;meta=json.loads((run/'command.json').read_bytes());assert meta['sourcesUnchanged']
 for x in json.loads((run/'members.json').read_bytes()):
  b=(run/x['path']).read_bytes();assert len(b)==x['bytes'] and hashlib.sha256(b).hexdigest()==x['sha256']
 print(json.dumps({'runVerified':label,'head':meta['head'],'sourceCount':len(meta['sourcesBefore']),'sourceBeforeEqualsAfter':True,'exitCode':meta['exitCode']}))
