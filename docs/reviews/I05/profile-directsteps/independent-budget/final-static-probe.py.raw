changed=subprocess.check_output(['git','diff','--name-only','ff90092e39c95f0195eb175f46538a8a822dfeb2',fixed['product']],text=True).splitlines();assert changed==['packages/engine/tests/test_semantic_profile_directsteps.py']
print(json.dumps({'controlled':len(fixed['files']),'readonly':sum(x['access']=='read-only' for x in fixed['files']),'currentEqualsFixedGit':True,'initialFrozenFilesVerified':len(initial['files']),'ffToFinalDelta':changed,'oldTestExactPrefixBytes':len(oldtest),'newTestBytes':len(newtest),'newTestSHA256':hashlib.sha256(newtest).hexdigest()}))
values=[None,True,False,'quote" slash\\ \n\r\b\f\t\x00\x1f','é中😀',{'integerHex':'-0x7ffff'},[],[{'kind':'leaf','reference':'i05-proof:'+'a'*64}],{'odd key\n':[False,None,'😀']}]
for value in values:
 ledger=d.DirectStepsLedger();ledger.begin(stage='encode');actual=p._direct_json_size(value,ledger);expected=len(json.dumps(value,ensure_ascii=False,sort_keys=True,separators=(',',':')).encode('utf-8'));assert actual==expected
 ledger.note_carrier(actual);receipt=ledger.receipt();ledger.completed()
