  "snippets": [
    {
      "label": "ProbeFault",
      "line_start": 261,
      "line_end": 266,
      "text": "261: class ProbeFault(ValueError):\n262:     \"\"\"Stable harness code only; never stringify an incoming exception.\"\"\"\n263: \n264:     def __init__(self, code):\n265:         self.code = code if type(code) is str and code.isascii() else \"HARNESS_FAILED\"\n266:         super().__init__(self.code)"
    },
    {
      "label": "CollectionBoundary",
      "line_start": 278,
      "line_end": 311,
      "text": "278: class CollectionBoundary:\n279:     \"\"\"Caller observation only; never replaces a canonical business callable.\"\"\"\n280: \n281:     def __init__(self, monotonic, started, cancel_requested):\n282:         self.monotonic, self.started = monotonic, started\n283:         self.cancel_requested = cancel_requested\n284:         self.stage, self.api = \"dispatch/input\", None\n285:         self.completed = []\n286:         self.attempts = []\n287: \n288:     def check(self):\n289:         if self.cancel_requested():\n290:             raise BoundaryStop(\"COLLECTION_STOP_REQUESTED\", 130, \"stopping\")\n291:         if self.monotonic() - self.started >= DEADLINE_SECONDS:\n292:             raise BoundaryStop(\"COLLECTION_DEADLINE\", 1, \"deadline-boundary\")\n293: \n294:     def call(self, stage, api, function, args, kwargs, capture=True):\n295:         self.stage, self.api = stage, api\n296:         self.check()\n297:         attempt = {\"stage\": stage, \"api\": api, \"start\": self.monotonic(), \"returned\": False}\n298:         self.attempts.append(attempt)\n299:         tick = time.perf_counter_ns()\n300:         try:\n301:             value = function(*args, **kwargs)\n302:         finally:\n303:             attempt[\"end\"] = self.monotonic()\n304:             attempt[\"elapsedNs\"] = time.perf_counter_ns() - tick\n305:         attempt[\"returned\"] = True\n306:         if capture:\n307:             # Retain actual references until this observation is written.\n308:             # No fake success, cross-case cache or native reconstruction.\n309:             self.completed.append({**attempt, \"value\": value})\n310:         self.check()  # An opaque call may finish late; never start the next one.\n311:         return value"
    },
    {
      "label": "_checked_call",
      "line_start": 314,
      "line_end": 318,
      "text": "314: def _checked_call(stage, api, function, *args, **kwargs):\n315:     boundary = _COLLECTION_CONTEXT.get()\n316:     if boundary is None:\n317:         return function(*args, **kwargs)\n318:     return boundary.call(stage, api, function, args, kwargs)"
    },
    {
      "label": "scope ProbeFault guard statement",
      "line_start": 1550,
      "line_end": 1551,
      "text": "1550:     if counter is None:\n1551:         raise ProbeFault(\"INTERNAL_ERROR\")"
    },
    {
      "label": "test_scope_without_counter_fails_before_loading_canonical_inputs",
      "line_start": 845,
      "line_end": 850,
      "text": "845: def test_scope_without_counter_fails_before_loading_canonical_inputs(probe):\n846:     # Empty mappings prove admission fails before module/dataset lookup or any\n847:     # canonical parse/prepare call; they do not stand in for a business result.\n848:     with pytest.raises(probe.ProbeFault) as failure:\n849:         probe._scope_observation({}, \"fresh\", {}, None)\n850:     assert failure.value.code == \"INTERNAL_ERROR\""
    },
    {
      "label": "_b1_observation",
      "line_start": 2101,
      "line_end": 2225,
      "text": "2101: def _b1_observation(dataset, modules, instrumentation):\n2102:     \"\"\"Future measurements of fixed pure inputs; no Store or heap/OS sampler.\"\"\"\n2103:     from rdflib import RDF, Graph, URIRef\n2104: \n2105:     semantic = modules[\"ontolearn_engine.semantic\"]\n2106:     passes = []\n2107:     first_graphs = None\n2108:     for name in (\"First\", \"Warm\"):\n2109:         phases = {}\n2110: \n2111:         def timed(phase, api, call, *, name=name, phases=phases):\n2112:             start = time.perf_counter_ns()\n2113:             value = _checked_call(name + \"/\" + phase, api, call)\n2114:             phases[phase] = {\n2115:                 \"elapsedNs\": time.perf_counter_ns() - start,\n2116:                 \"pythonAllocation\": \"unknown\",\n2117:                 \"processHighWaterRss\": \"unknown\",\n2118:             }\n2119:             return value\n2120: \n2121:         asserted = timed(\n2122:             \"turtleParse\",\n2123:             \"semantic.parse_turtle\",\n2124:             lambda: semantic.parse_turtle(dataset[\"assertedText\"]),\n2125:         )\n2126:         ontology = timed(\n2127:             \"ontologyParse\",\n2128:             \"semantic.parse_turtle\",\n2129:             lambda: semantic.parse_turtle(dataset[\"ontologyText\"]),\n2130:         )\n2131: \n2132:         def build(*, asserted=asserted, ontology=ontology):\n2133:             # Explicit input transformation, not derived facts or an alternate reasoner.\n2134:             facts = Graph()\n2135:             for triple in asserted:\n2136:                 facts.add(triple)\n2137:             for replacement in dataset[\"replaceEquipmentTypes\"]:\n2138:                 subject = URIRef(replacement[\"subject\"])\n2139:                 facts.remove((subject, RDF.type, None))\n2140:                 facts.add((subject, RDF.type, URIRef(replacement[\"type\"])))\n2141:             combined = Graph()\n2142:             for triple in facts:\n2143:                 combined.add(triple)\n2144:             for triple in ontology:\n2145:                 combined.add(triple)\n2146:             return facts, combined\n2147: \n2148:         transformed, combined = timed(\"graphBuild\", \"probe.explicitInputGraphBuild\", build)\n2149:         query = timed(\n2150:             \"fixedSelect\",\n2151:             \"semantic.query\",\n2152:             lambda *, combined=combined: semantic.query(combined, dataset[\"queryText\"]),\n2153:         )\n2154:         reason = timed(\n2155:             \"rdfsRules\",\n2156:             \"semantic.reason\",\n2157:             lambda *, combined=combined: semantic.reason(combined, _legacy_rules(dataset, modules)),\n2158:         )\n2159:         shapes = timed(\n2160:             \"shapesParse\",\n2161:             \"semantic.parse_turtle\",\n2162:             lambda: semantic.parse_turtle(dataset[\"shapesText\"], shapes=True),\n2163:         )\n2164:         report = timed(\n2165:             \"shacl\",\n2166:             \"semantic.check_shapes\",\n2167:             lambda *, asserted=asserted, shapes=shapes: semantic.check_shapes(asserted, shapes),\n2168:         )\n2169:         outputs = {\n2170:             \"assertedOriginal\": _graph_value(asserted),\n2171:             \"transformedFacts\": _graph_value(transformed),\n2172:             \"ontology\": _graph_value(ontology),\n2173:             \"graph\": _graph_value(combined),\n2174:             \"query\": query,\n2175:             \"reason\": reason,\n2176:             \"report\": report,\n2177:         }\n2178:         # The timer observes encoding only; JSONL transport/parent wall is a distinct domain.\n2179:         encoded = timed(\n2180:             \"resultSerialization\",\n2181:             \"probe.canonical_bytes\",\n2182:             lambda *, outputs=outputs: canonical_bytes(outputs),\n2183:         )\n2184:         passes.append(\n2185:             {\n2186:                 \"name\": name,\n2187:                 \"phases\": phases,\n2188:                 \"outputs\": outputs,\n2189:                 \"serializationBytes\": len(encoded),\n2190:                 \"serializationSha256\": hashlib.sha256(encoded).hexdigest(),\n2191:             }\n2192:         )\n2193:         if first_graphs is None:\n2194:             first_graphs = (asserted, ontology, combined)\n2195:     asserted, ontology, combined = first_graphs\n2196:     return {\n2197:         \"scale\": dataset[\"scale\"],\n2198:         \"seed\": dataset[\"seed\"],\n2199:         \"assertedInput\": _graph_value(asserted),\n2200:         \"ontology\": _graph_value(ontology),\n2201:         \"semanticGraph\": _graph_value(combined),\n2202:         \"actualCounts\": {\n2203:             \"asserted\": len(asserted),\n2204:             \"ontology\": len(ontology),\n2205:             \"merged\": len(combined),\n2206:         },\n2207:         \"inputSha256\": hashlib.sha256(dataset[\"assertedText\"].encode(\"utf-8\")).hexdigest(),\n2208:         \"ontologyTextSha256\": hashlib.sha256(dataset[\"ontologyText\"].encode(\"utf-8\")).hexdigest(),\n2209:         \"querySha256\": hashlib.sha256(dataset[\"queryText\"].encode(\"utf-8\")).hexdigest(),\n2210:         \"transformedGraphSha256\": hashlib.sha256(\n2211:             canonical_bytes(_graph_value(combined))\n2212:         ).hexdigest(),\n2213:         \"instrumentation\": instrumentation,\n2214:         \"coldClaim\": False,\n2215:         \"freshProcessRequestedBySelector\": not instrumentation,\n2216:         \"freshProcessExternallyVerified\": False,\n2217:         \"timer\": \"perf_counter_ns\",\n2218:         \"timerResolutionSeconds\": time.get_clock_info(\"perf_counter\").resolution,\n2219:         \"importStartupWall\": \"unknown\",\n2220:         \"physicalColdRead\": \"unknown\",\n2221:         \"snapshotLoad\": \"not-executed; Store HOLD\",\n2222:         \"capacityThreshold\": \"unknown\",\n2223:         \"memoryMeasurementStatus\": \"unknown; requires later resource/tool ticket\",\n2224:         \"passes\": passes,\n2225:     }"
    },
