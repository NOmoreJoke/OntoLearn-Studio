import hashlib
import json
from pathlib import Path
import subprocess

OUT = Path(__file__).resolve().parent
ROOT = OUT.parents[3]
candidate = json.loads((OUT / "candidate.json").read_bytes())
fixed = json.loads((OUT / "inputs/I05-shacl-integer-entry-fixed-inputs.json.raw").read_bytes())
audit = json.loads((OUT / "actual-report-audit.json").read_bytes())
product = candidate["product"]
continuation = candidate["continuation"]
base = candidate["base"]

def git(*argv):
    return subprocess.check_output(["git", *argv], cwd=ROOT)

def identity(path):
    raw = path.read_bytes()
    return {"bytes": len(raw), "sha256": hashlib.sha256(raw).hexdigest()}

def dump(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n")

def tree(ref):
    result = {}
    for entry in git("ls-tree", "-r", "-z", ref).split(b"\0"):
        if entry:
            metadata, path = entry.split(b"\t", 1)
            mode, kind, blob = metadata.decode().split()
            result[path.decode()] = {"mode": mode, "type": kind, "blob": blob}
    return result

assert git("rev-parse", "HEAD").decode().strip() == product
assert all(p.startswith(str(OUT.relative_to(ROOT)) + "/") for p in git("diff", "--name-only", product).decode().splitlines())
assert audit["product"] == product
first = json.loads((OUT / "runs/01-full-check/run.json").read_bytes())
assert first["exit"] == 1 and not first["timeout"] and not first["sourceChanged"]
assert first["gitHead"] == candidate["firstProduct"]
assert first["sourcesBefore"] == first["sourcesAfter"] == json.loads((OUT / "first-candidate-be61.json").read_bytes())["controlled"]
assert b"1 failed, 5051 passed, 44 skipped" in (OUT / "runs/01-full-check/stdout.raw").read_bytes()
commands = []
for name in ("03-full-check", "04-verify-sources", "05-product-diff-check", "07-staged-text-check"):
    path = OUT / "runs" / name / "run.json"
    record = json.loads(path.read_bytes())
    assert record["exit"] == 0 and not record["timeout"] and not record["sourceChanged"]
    assert record["gitHead"] == product
    assert record["sourcesBefore"] == record["sourcesAfter"] == candidate["controlled"]
    commands.append({"path": str(path.relative_to(ROOT)), **identity(path), "argv": record["argv"], "exit": 0, "timeout": False, "sourcesBeforeAfter": 145})
assert b"12" in (OUT / "runs/04-verify-sources/stdout.raw").read_bytes()
raw_exceptions = json.loads((OUT / "raw-whitespace-exceptions.json").read_bytes())
staged_first = json.loads((OUT / "runs/06-staged-diff-check/run.json").read_bytes())
assert staged_first["exit"] == 2 and not staged_first["sourceChanged"]
for row in raw_exceptions["exactExclusionsForRemainingTextCheck"]:
    assert identity(ROOT / row["path"]) == {k: row[k] for k in ("bytes", "sha256")}
review = OUT / "independent-review/final-91e9807/report.md"
assert review.exists()
old_frozen = json.loads((OUT / "frozen-prior-process-git.json").read_bytes())
product_tree = tree(product)
for row in old_frozen["files"]:
    assert product_tree[row["path"]] == {k: row[k] for k in ("mode", "type", "blob")}
for row in candidate["controlled"]:
    assert identity(ROOT / row["path"]) == {k: row[k] for k in ("bytes", "sha256")}
    assert git("show", product + ":" + row["path"]) == (ROOT / row["path"]).read_bytes()
assert set(git("diff", "--name-only", continuation, product).decode().splitlines()) == set(candidate["onlyProductChanges"])

readme = f"""# SHACL 非法整数独立文本入口

仅本组件窗口有限通过。continuation `{continuation}`，固定产品 `{product}`；日期政策、正式execution/Store/Job/selected接线及父功能验收不在本次结论内。Q6沿用已采纳结论。

## 行为与范围

`validate_shacl_text(data_text, shapes_text, *, data_policy, range_policy)` 两个policy均须显式提供。data_policy只接受strict、integer-illtyped-report-v1；range_policy只接受legacy。未知策略固定SCOPE_SELECTION_TYPE_INVALID。返回entryVersion=i05-shacl-text-1、两项实际policy和真实report；旧SEMANTICS_VERSION=i05-finite-6及旧报告结构不变，无cache/公共参数接线。

唯一宽点为数据object、精确xsd:integer、ill_typed is True，保原lexical/datatype/三元组，shape仍严格。真实target和constraint决定结果，无目标或无约束可conforms=true。旧parse/query/reason/check保持strict，日期bound保持INVALID_SHAPE且Validator0。没有全局转换表、DAWG/parser/logger/constraint-map修改、吞错继续或补造violation。

相对continuation恰一改semantic.py、一新增专用测试；145受控、143只读。旧1238过程只冻结Git mode/type/blob身份，不重审旧257MB内容。最新操作AGENTS及common全文读取并归档在inputs，旧Git AGENTS保持原字节；操作规则更新不改变产品决定。

## 实际验证

最终03正常完整check exit0：1125项TS、5060项Python通过，44项既有跳过；新增70实例，原77 DAG和26 shape在同一次完整运行。新入口78份观察=14次真实Validator调用+64次前门拒绝，真实结果4个true/10个false；原26 shape=9次调用+17次拒绝，覆盖重叠不相加为新用例数。actual-report-audit逐原始RDF report核完整六字段和conforms，未伪造BNode ID或缺省value。本轮未开启D费用大快照采集，不外推费用或性能结论。

另04 verify:sources核12来源exit0；05产品diff检查exit0。06完整暂存空白检查exit2，仅原始patch/首失败trace的空白字符；三原件及06检查自身stdout原字节保留，四件精确raw例外见raw-whitespace-exceptions.json。07检查其余全部暂存文本exit0，无产品或活动代码例外。所有验证记录完整argv/cwd/env/开始结束/exit/timeout和145项来源前后身份，新树独立node_modules/.venv及临时目录。无GUI/native/e2e/HMR/外部模型/付费/push/PR/merge。独立审查仅新入口与本轮证据，报告见independent-review/final-91e9807。

## 首失败与修复

首候选be61c928的01完整check实际1 failed/5051 passed/44 skipped/1 warning：非法IRI在_terms的n3排序先抛原始库Exception。首候选、双流、首轮70份观察及首审不通过报告原件保留，没有改预期求绿。

91e9807仅在新文本入口启用排序前的实际URIRef/literal datatype IRI检查，按原IRI字面边界固定拒绝；旧API调用顺序不变。保原失败测试并新增subject/predicate/datatype/shape-path×两策略共8向量，再以新候选完整check验证。坏decimal的既有RDFLib序列化warning保留，未通过全局logger/warning设置消除。

最终来源、过程成员和原件hash见final-manifest.json、validation.json；manifest自hash由交付回执外部绑定。正式执行链仍有严格facts/scopes/selected门，本组件通过不等于正式链支持非法整数。
"""
(OUT / "README.md").write_text(readme)
validation = {"base": base, "continuation": continuation, "product": product, "controlled": 145, "readonly": 143, "newTestInstances": 70, "checks": commands, "reportAudit": {"path": str((OUT / "actual-report-audit.json").relative_to(ROOT)), **identity(OUT / "actual-report-audit.json")}, "independentReview": {"path": str(review.relative_to(ROOT)), **identity(review), "scope": "new entry/delta/new evidence only; report read back by owner"}, "firstFailure": {"product": candidate["firstProduct"], "run": "runs/01-full-check", "exit": 1, "pythonFailed": 1, "pythonPassed": 5051, "existingSkipped": 44, "report": "independent-review/first-be61/report-be61c92.md", "retained": True}, "frozenPriorProcessGitCount": 1238, "notClosed": ["date policy", "formal execution/Store/Job/selected", "parent feature", "specified dual-model review", "CI", "OS/human acceptance", "develop/remote merge"], "globalSemanticsVersionUnchanged": True, "guiNativeExternalModelsPaidPushPrMerge": False}
validation["stagedWhitespace"] = raw_exceptions
old_root = Path(fixed["files"][0]["sourceTree"])
old_head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=old_root).decode().strip()
old_status = subprocess.check_output(["git", "status", "--porcelain"], cwd=old_root).decode()
assert old_head == continuation and not old_status
validation["oldCombinedTree"] = {"path": str(old_root), "head": old_head, "status": old_status, "unchanged": True}
dump(OUT / "validation.json", validation)
manifest_path = OUT / "final-manifest.json"
manifest_path.write_text("{}\n")
new_paths = sorted(p for p in OUT.rglob("*") if p.is_file())
controlled = []
for row in candidate["controlled"]:
    source = next((r for r in fixed["files"] if r["path"] == row["path"]), None)
    controlled.append({**row, "productRef": product, "gitBlob": product_tree[row["path"]]["blob"], "currentEqualsProductGit": True, "role": "read-only" if source and source["role"] == "read-only" else "writer", "inputSourceRef": source["sourceRef"] if source else None, "inputSha256": source["sha256"] if source else None})
new_process = [{"path": str(path.relative_to(ROOT)), **(identity(path) if path != manifest_path else {"bytes": None, "sha256": None, "selfHashBoundByDeliveryReceipt": True})} for path in new_paths]
declared = {row["path"] for row in controlled + old_frozen["files"] + new_process}
assert len(declared) == 145 + 1238 + len(new_process)
base_diff = set(git("diff", "--name-only", base, product).decode().splitlines())
base_diff.update(row["path"] for row in new_process)
same = sorted(declared - base_diff)
assert len(same) == 9 and base_diff <= declared
manifest = {"base": base, "continuation": continuation, "product": product, "controlledCount": 145, "readonlyCount": 143, "frozenPriorProcessGitCount": 1238, "newProcessCount": len(new_process), "totalCount": len(declared), "actualBaseDiffCount": len(base_diff), "sameAsBaseCount": len(same), "sameAsBase": same, "actualBaseDiff": sorted(base_diff), "controlled": controlled, "frozenPriorProcessGit": old_frozen["files"], "newProcess": new_process}
dump(manifest_path, manifest)
print(json.dumps({k: manifest[k] for k in ("product", "controlledCount", "readonlyCount", "frozenPriorProcessGitCount", "newProcessCount", "totalCount", "actualBaseDiffCount", "sameAsBaseCount")}))
