+def check_declared_pool_sources():
+    specs = [
+        ("allocation-integration-plan.md.raw", 72, 80),
+        ("allocation-restore-plan.md.raw", 103, 109),
+    ]
+    for name, start, end in specs:
+        text = "\n".join((EVIDENCE / "guidance" / name).read_text().splitlines()[start - 1 : end])
+        aliases = {
+            "input_bytes": "input(?:_bytes)?",
+            "output_bytes": "output(?:_bytes)?",
+            "trace_items": "trace(?:_items)?",
+        }
+        found = {}
+        for key in DECLARED_POOLS:
+            matches = re.findall(r"(?<![A-Za-z_])" + aliases.get(key, key) + r"(\d+)(?!\d)", text)
+            if not matches or len(set(matches)) != 1:
+                raise ValueError("missing or ambiguous normative pool: " + key)
+            found[key] = int(matches[0])
+        if found != DECLARED_POOLS:
+            raise ValueError("declared pool differs from pinned normative lines")
