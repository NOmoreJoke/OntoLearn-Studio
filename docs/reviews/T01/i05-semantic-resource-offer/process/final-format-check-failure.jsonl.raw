ons/T01/i05-semantic-resource-offer.md')]+sorted(pre.rglob('*')):\\n if p.is_file() and p.name!='delivery-manifest.json':\\n  b=p.read_bytes();files.append({'path':p.as_posix(),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest()})\\np=pre/'delivery-manifest.json';p.write_text(json.dumps({'base':'5f910b52c69d86a1076b2032e5d3c63e715947f3','reviewedCandidate':'dd972b79adf4d378636a7d41a6b0e3e08c0d5ca1','finalProcessHead':'Reported after actual commit in tool receipt, not self-referenced','scope':'All final local delivery files; excludes this manifest itself. Pure process additions do not alter accepted supplier inputs or reviewed candidate.','fileCountExcludingThisManifest':len(files),'totalBytesExcludingThisManifest':sum(x['bytes'] for x in files),'files':files},ensure_ascii=False,indent=2)+'\\\\n')\\nsubprocess.run([fmt,'--ignore-path','/dev/null','--check',str(root/p)],check=True)\\nprint(json.dumps({'payloadFiles':len(files),'payloadBytes':sum(x['bytes'] for x in files),'deliveryManifestBytes':p.stat().st_size,'deliveryManifestSha256':hashlib.sha256(p.read_bytes()).hexdigest()},ensure_ascii=False))\\nPY\",\"workdir\":load(\"offerTree\"),\"max_output_tokens\":1500}));\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a1620a-14f9-72e2-ac3e-bdcf4cf13f10","create_time":1792648393.9641275}}}
