  "rules": {
    "FIELD-COVERAGE": "Every original directory field once in original order, including inherited14/15, native_kind, sidecars/preimages. Unknown actual field keeps existing bytes and blocks complete export; no silent ignore.",
    "UNREFINED": "object/plain tuple/dict/incomplete class directory stays blocked even sample looks JSON. Preserve existing raw when available; no original byte wire invented. Live references require future actual owner/lifetime authority.",
    "NO-REFLECTION": "future exact explicitly approved class/field adapter only; no generic getattr/__dict__/repr/str or source-pin following.",
    "ORIGINAL-CODECS": "production flat recordType+fields versus probe full-module recordType+nested fields; hex/base64/integerHex and list/tuple collapse kept distinct.",
    "STATE": "NoneValue is actual None, blocked/not-reached/no-wire different; no expected fill or success by omission.",
    "RAW": "all original bytes/tails/duplicates/old digests/native_kind preserved; no whole-value retention claim when unknown live object has no export codec.",
    "ADOPTION": "all definitions NEW proposed, require Q04 exact owner/root adoption and actual pins; identity-policy role reception does not adopt this codec.",
    "STREAM": "no strict18/header/four-schema/old1241 changes. Future carrier2 stage layoutId/codecId must explicitly adopt this proposed artifact and same attempt/raw/prior build, list in manifest; old versions reject unknown codec rather than skip.",
    "CAPS": "full originals plus new encoding need approved capture/admission/budget accounting; no hidden files bypass caps, no suppression of originals or inferred physical authority.",
    "HASH": "retain original byte/preimage digests; separate proposed relation tag excludes self/future manifest/receipt and provides no semantic/issuer proof."
  },
  "currentGateState": {
    "grammarAdopted": false,
    "fullValueAdapterClosed": false,
    "sourcePermissionVerified": false,
    "sameIssueLiveAuthorityVerified": false,
    "wholeM02M05Closed": false,
    "runtimeAuthorized": false
  }
}
