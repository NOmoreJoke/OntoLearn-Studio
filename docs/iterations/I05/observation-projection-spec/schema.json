    "rejection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "rejection"
            },
            "complete": {
              "const": true
            },
            "harnessStage": {
              "enum": [
                "reason",
                "rule-definition",
                "scope",
                "restore",
                "structured-material-required",
                "parse-data",
                "parse-shapes",
                "scope-provenance-gate",
                "scope-selection-gate",
                "implicit-loader-guard"
              ]
            },
            "diagnostic": {
              "$ref": "#/$defs/knownDiagnostic"
            },
            "partialView": {
              "type": "null"
            },
            "report": {
              "type": "null"
            }
          },
          "required": ["kind", "complete", "harnessStage", "diagnostic", "partialView", "report"],
          "additionalProperties": false
