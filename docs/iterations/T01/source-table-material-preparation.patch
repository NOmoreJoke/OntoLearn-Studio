+/** Complete source-table material, independent of the single-frame wire budget.
+ * The trusted owner must supply its total encoded budget and source identity.
+ * This binds parser identity labels; it does not authenticate a producer.
+ */
+export function sourceTableMaterial(
+  table: unknown,
+  options: unknown,
+  implementation: unknown,
+  expectedSourceHash: string,
+  maxEncodedBytes: number,
+): Uint8Array {
+  if (
+    !Number.isSafeInteger(maxEncodedBytes) ||
+    maxEncodedBytes < 1 ||
+    !validateV2('hash', expectedSourceHash) ||
+    !validateV2('implementation', implementation)
+  )
+    return fail()
+  const record = (v: unknown, keys: string[]): Record<string, unknown> => {
+    if (!v || typeof v !== 'object' || Array.isArray(v)) return fail()
+    const descriptors = Object.getOwnPropertyDescriptors(v)
+    if (
+      ![Object.prototype, null].includes(Object.getPrototypeOf(v)) ||
+      Reflect.ownKeys(v).length !== keys.length ||
+      keys.some((k) => !Object.hasOwn(descriptors, k) || !('value' in descriptors[k]))
+    )
+      return fail()
+    return v as Record<string, unknown>
+  }
+  const array = (v: unknown, max: number): unknown[] => {
+    if (
+      !Array.isArray(v) ||
+      v.length > max ||
+      Reflect.ownKeys(v).length !== v.length + 1 ||
+      Object.keys(v).length !== v.length
+    )
+      return fail()
+    for (let i = 0; i < v.length; i++)
+      if (!Object.hasOwn(v, i) || !('value' in Object.getOwnPropertyDescriptor(v, i)!))
+        return fail()
+    return v
+  }
+  const t = record(table, ['source_hash', 'sheet', 'fields', 'rows'])
+  const o = record(options, ['format', 'encoding', 'sheet'])
+  const impl = record(implementation, [
+    'executionSemanticsVersion',
+    'engineVersion',
+    'dependencyLockHash',
+  ])
+  if (
+    t.source_hash !== expectedSourceHash ||
+    typeof t.sheet !== 'string' ||
+    (o.format === 'csv'
+      ? o.encoding !== 'utf-8-sig' || o.sheet !== null || t.sheet !== 'CSV'
+      : o.format !== 'xlsx' || o.encoding !== null || o.sheet !== t.sheet)
+  )
+    return fail()
+  const fields = array(t.fields, 256)
+  const rows = array(t.rows, 50000)
+  if (!fields.length) return fail()
+  const whitespace =
+    /^[\u0009-\u000d\u001c-\u0020\u0085\u00a0\u1680\u2000-\u200a\u2028\u2029\u202f\u205f\u3000]+$/u
+  const kinds = new Set(['string', 'empty', 'boolean', 'datetime', 'date', 'number'])
+  const encoder = new TextEncoder()
+  let output: Uint8Array | undefined
+  let offset = 0
+  const add = (text: string, size: number) => {
+    if (size > maxEncodedBytes - offset) return fail()
+    if (output) {
+      const written = encoder.encodeInto(text, output.subarray(offset)).written
+      if (written !== size) return fail()
+    }
+    offset += size
+  }
+  const token = (text: string) => add(text, text.length)
+  const string = (value: unknown, max?: number, nonempty = false, noNul = false) => {
+    if (typeof value !== 'string') return fail()
+    let count = 0
+    let size = 2
+    for (const c of value) {
+      const cp = c.codePointAt(0)!
+      if ((cp >= 0xd800 && cp <= 0xdfff) || (noNul && cp === 0)) return fail()
+      count++
+      if (max !== undefined && count > max) return fail()
+      size +=
+        c === '"' || c === '\\' || '\b\f\n\r\t'.includes(c)
+          ? 2
+          : cp < 32
+            ? 6
+            : cp < 128
+              ? 1
+              : cp < 2048
+                ? 2
+                : cp < 65536
+                  ? 3
+                  : 4
+      if (size > maxEncodedBytes - offset) return fail()
+    }
+    if (size > maxEncodedBytes - offset || (nonempty && (!count || whitespace.test(value))))
+      return fail()
+    // Never allocate an escaped scalar before its exact encoded budget passes.
+    if (output) add(JSON.stringify(value), size)
+    else offset += size
+  }
+  const walk = () => {
+    token('[')
+    string('ontolearn.source-table')
+    token(',1,')
+    string(t.source_hash)
+    token(',[')
+    string(o.format)
+    token(',')
+    if (o.encoding === null) token('null')
+    else string(o.encoding)
+    token(',')
+    if (o.sheet === null) token('null')
+    else string(o.sheet)
+    token('],[')
+    for (const [i, key] of [
+      'executionSemanticsVersion',
+      'engineVersion',
+      'dependencyLockHash',
+    ].entries()) {
+      if (i) token(',')
+      string(impl[key])
+    }
+    token('],')
+    string(t.sheet)
+    token(',[')
+    const seen = new Set<string>()
+    fields.forEach((field, i) => {
+      if (i) token(',')
+      string(field, 32768, true, true)
+      if (seen.has(field as string)) return fail()
+      seen.add(field as string)
+    })
+    token('],[')
+    let previous = 1
+    rows.forEach((value, i) => {
+      const row = record(value, ['number', 'cells'])
+      if (
+        typeof row.number !== 'number' ||
+        !Number.isSafeInteger(row.number) ||
+        row.number <= previous ||
+        row.number > 50001
+      )
+        return fail()
+      previous = row.number
+      const cells = array(row.cells, 256)
+      if (cells.length !== fields.length) return fail()
+      if (i) token(',')
+      token(`[${row.number},[`)
+      cells.forEach((value, j) => {
+        const cell = record(value, ['text', 'kind'])
+        if (
+          !kinds.has(cell.kind as string) ||
+          (o.format === 'csv' && cell.kind !== 'string') ||
+          (cell.kind === 'empty' && cell.text !== '') ||
+          (cell.kind === 'boolean' && !['true', 'false'].includes(cell.text as string))
+        )
+          return fail()
+        if (j) token(',')
+        token('[')
+        string(cell.text, 32768, false, true)
+        token(',')
+        string(cell.kind)
+        token(']')
+      })
+      token(']]')
+    })
+    token(']]')
+  }
+  walk()
+  output = new Uint8Array(offset)
+  offset = 0
+  walk()
+  if (offset !== output.length) return fail()
+  return output
+}
