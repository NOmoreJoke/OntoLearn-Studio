+def source_table_material(table, options, implementation, expected_source_hash, max_encoded_bytes):
+    """Full canonical bytes only; producer identity/authentication is owner-issued."""
+
+    def invalid():
+        raise ValueError("INVALID_REQUEST")
+
+    if (
+        type(max_encoded_bytes) is not int
+        or not 1 <= max_encoded_bytes <= 2**53 - 1
+        or not validate("hash", expected_source_hash)
+        or not validate("implementation", implementation)
+    ):
+        invalid()
+
+    def record(value, keys):
+        if type(value) is not dict or set(value) != set(keys):
+            invalid()
+        return value
+
+    def array(value, maximum):
+        if type(value) is not list or len(value) > maximum:
+            invalid()
+        return value
+
+    t = record(table, ("source_hash", "sheet", "fields", "rows"))
+    o = record(options, ("format", "encoding", "sheet"))
+    impl = record(
+        implementation, ("executionSemanticsVersion", "engineVersion", "dependencyLockHash")
+    )
+    if (
+        t["source_hash"] != expected_source_hash
+        or type(t["sheet"]) is not str
+        or (
+            (o["encoding"] != "utf-8-sig" or o["sheet"] is not None or t["sheet"] != "CSV")
+            if o["format"] == "csv"
+            else (o["format"] != "xlsx" or o["encoding"] is not None or o["sheet"] != t["sheet"])
+        )
+    ):
+        invalid()
+    fields, rows = array(t["fields"], 256), array(t["rows"], 50000)
+    if not fields:
+        invalid()
+    kinds = {"string", "empty", "boolean", "datetime", "date", "number"}
+    output = None
+    offset = 0
+
+    def add(text, size):
+        nonlocal offset
+        if size > max_encoded_bytes - offset:
+            invalid()
+        if output is not None:
+            encoded = text.encode("utf-8")
+            if len(encoded) != size:
+                invalid()
+            output[offset : offset + size] = encoded
+        offset += size
+
+    def token(text):
+        add(text, len(text))
+
+    def string(value, maximum=None, nonempty=False, no_nul=False):
+        nonlocal offset
+        if type(value) is not str:
+            invalid()
+        size = 2
+        for count, char in enumerate(value, 1):
+            cp = ord(char)
+            if 0xD800 <= cp <= 0xDFFF or (no_nul and cp == 0):
+                invalid()
+            if maximum is not None and count > maximum:
+                invalid()
+            size += (
+                2
+                if char in '\\"\b\f\n\r\t'
+                else 6
+                if cp < 32
+                else 1
+                if cp < 128
+                else 2
+                if cp < 2048
+                else 3
+                if cp < 65536
+                else 4
+            )
+            if size > max_encoded_bytes - offset:
+                invalid()
+        if size > max_encoded_bytes - offset or (nonempty and (not value or value.isspace())):
+            invalid()
+        if output is not None:
+            add(json.dumps(value, ensure_ascii=False, separators=(",", ":")), size)
+        else:
+            offset += size
+
+    def walk():
+        token("[")
+        string("ontolearn.source-table")
+        token(",1,")
+        string(t["source_hash"])
+        token(",[")
+        string(o["format"])
+        token(",")
+        token("null") if o["encoding"] is None else string(o["encoding"])
+        token(",")
+        token("null") if o["sheet"] is None else string(o["sheet"])
+        token("],[")
+        for i, key in enumerate(
+            ("executionSemanticsVersion", "engineVersion", "dependencyLockHash")
+        ):
+            if i:
+                token(",")
+            string(impl[key])
+        token("],")
+        string(t["sheet"])
+        token(",[")
+        seen = set()
+        for i, field in enumerate(fields):
+            if i:
+                token(",")
+            string(field, 32768, True, True)
+            if field in seen:
+                invalid()
+            seen.add(field)
+        token("],[")
+        previous = 1
+        for i, value in enumerate(rows):
+            row = record(value, ("number", "cells"))
+            number = row["number"]
+            if (
+                type(number) not in {int, float}
+                or not math.isfinite(number)
+                or number != int(number)
+                or not previous < number <= 50001
+            ):
+                invalid()
+            previous = number
+            cells = array(row["cells"], 256)
+            if len(cells) != len(fields):
+                invalid()
+            if i:
+                token(",")
+            token(f"[{int(number)},[")
+            for j, value in enumerate(cells):
+                cell = record(value, ("text", "kind"))
+                if (
+                    type(cell["kind"]) is not str
+                    or cell["kind"] not in kinds
+                    or (o["format"] == "csv" and cell["kind"] != "string")
+                    or (cell["kind"] == "empty" and cell["text"] != "")
+                    or (cell["kind"] == "boolean" and cell["text"] not in ("true", "false"))
+                ):
+                    invalid()
+                if j:
+                    token(",")
+                token("[")
+                string(cell["text"], 32768, False, True)
+                token(",")
+                string(cell["kind"])
+                token("]")
+            token("]]")
+        token("]]")
+
+    walk()
+    output = bytearray(offset)
+    offset = 0
+    walk()
+    if offset != len(output):
+        invalid()
+    return bytes(output)
+
