  "runnerCode": "import json,sys,platform,pathlib\npayload=json.load(sys.stdin)\nmodule={\"__name__\":\"i05_read_only_inventory_check\"}\nexec(compile(payload[\"script\"],\"i05-build-inventory.py\",\"exec\"),module)\nidentity={\"system\":platform.system(),\"machine\":platform.machine(),\"pythonVersion\":platform.python_version(),\"build\":(pathlib.Path(sys.base_prefix)/\"BUILD\").read_text().strip()}\nassert identity==payload[\"native\"][\"runtime\"]\nmodule[\"_match_linux\"](pathlib.Path(sys.base_prefix),payload[\"native\"])\nprint(json.dumps({\"identity\":identity,\"matchedElfFiles\":len(payload[\"native\"][\"binaryFiles\"]),\"readOnly\":True}))\n"
